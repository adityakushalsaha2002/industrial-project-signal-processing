{ "cells": [ { "cell_type": "code", "execution_count": 2, "id": "a065bbc0", "metadata": {}, "outputs": [], "source": [ "# Imports, preprocessing config\n", "import numpy as np\n", "import pandas as pd\n", "import gc, json, time\n", "from pathlib import Path\n", "from scipy.ndimage import median_filter\n", "from scipy.signal import find_peaks\n", "\n", "CFG = {\n", " # Preprocessing settings\n", " 'input_dir': Path('./Test signals from previous years/Suction data/Original'),\n", " 'output_dir': Path('./Test signals from previous years/Suction data/Preprocessed'),\n", " 'original_fs': 50_000, # Hz\n", " 'target_fs': 500, # Hz\n", " 'adc_column': 'adc2',\n", " 'adc_col_index': None,\n", " 'chunk_rows': 10_000_000,\n", " 'baseline_sec': 5.0,\n", " 'uint16_offset': 32_768,\n", " 'overwrite': False,\n", "}\n", "CFG['pool_block'] = CFG['original_fs'] // CFG['target_fs']\n", "CFG['output_dir'].mkdir(parents=True, exist_ok=True)" ] }, { "cell_type": "code", "execution_count": 3, "id": "a03e62cc", "metadata": {}, "outputs": [], "source": [ "# Cell 2: utility funcions\n", "def sniff_csv(path):\n", " """Return (delimiter, has_header, n_columns) from the first line."""\n", " with open(path, 'r') as f:\n", " first = f.readline()\n", " delim = '\t' if first.count('\t') >= first.count(',') else ','\n", " parts = [p.strip() for p in first.rstrip('\r\n').split(delim) if p != '']\n", " is_numeric = all(p.lstrip('-').replace('.', '', 1).isdigit() for p in parts)\n", " return delim, (not is_numeric), len(parts)\n", "\n", "def load_adc_chunks(path, cfg):\n", " """Yield the ADC column as int32 arrays, one chunk at a time."""\n", " delim, header, ncols = sniff_csv(path)\n", " if header:\n", " cols = pd.read_csv(path, sep=delim, nrows=0).columns.tolist()\n", " usecols = cfg['adc_column'] if cfg['adc_column'] in cols else cols[cfg['adc_col_index']]\n", " else:\n", " usecols = cfg['adc_col_index']\n", "\n", " for chunk in pd.read_csv(path, sep=delim, usecols=[usecols],\n", " header=0 if header else None,\n", " chunksize=cfg['chunk_rows'],\n", " dtype=np.int32, engine='c'):\n", " yield chunk.iloc[:, 0].to_numpy(dtype=np.int32)\n", " del chunk" ] }, { "cell_type": "code", "execution_count": 4, "id": "5829bc7f", "metadata": {}, "outputs": [], "source": [ "# Cell 3: Block-mean downsampling (no cross-chunk state, no edge artifacts)\n", "def pool_downsample(chunks, block):\n", " """Mean-pool every block raw samples → 1 output sample."""\n", " parts, carry = [], np.empty(0, dtype=np.int32)\n", " total_raw = 0\n", " for arr in chunks:\n", " total_raw += len(arr)\n", " arr = np.concatenate([carry, arr]) if len(carry) else arr\n", " n_blocks = len(arr) // block\n", " if n_blocks:\n", " usable = n_blocks * block\n", " parts.append(arr[:usable].reshape(n_blocks, block).mean(axis=1, dtype=np.int32))\n", " carry = arr[usable:].copy()\n", " else:\n", " carry = arr\n", " del arr\n", " if len(carry):\n", " parts.append(np.array([carry.mean()], dtype=np.int32))\n", " return np.concatenate(parts), total_raw" ] }, { "cell_type": "code", "execution_count": 5, "id": "bc2ab0c8", "metadata": {}, "outputs": [], "source": [ "# Cell 4: Full single-file preprocessing (decimate → baseline → uint16 .bin + sidecar)\n", "def preprocess_file(csv_path, cfg):\n", " bin_path = cfg['output_dir'] / (csv_path.stem + '.bin')\n", " meta_path = cfg['output_dir'] / (csv_path.stem + '.meta.json')\n", "\n", " if bin_path.exists() and not cfg['overwrite']:\n", " print(f"{csv_path.name}: .bin already exists (set overwrite=True to redo)")\n", " return bin_path\n", "\n", " t0 = time.time()\n", " raw_mb = csv_path.stat().st_size / 10242\n", "\n", " # 1. Read + downsample\n", " pooled, n_raw = pool_downsample(load_adc_chunks(csv_path, cfg), cfg['pool_block'])\n", " expected = n_raw / cfg['pool_block']\n", " assert abs(len(pooled) - expected) <= 1, f"samples lost: {len(pooled)} vs {expected:.1f}"\n", "\n", " # 2. Baseline removal\n", " win = int(cfg['baseline_sec'] * cfg['target_fs'])\n", " win += 1 if win % 2 == 0 else 0\n", " centered = pooled - median_filter(pooled, size=win)\n", "\n", " # 3. Convert to uint16\n", " u16 = np.clip(centered + cfg['uint16_offset'], 0, 65_535).astype(np.uint16)\n", " u16.tofile(bin_path)\n", "\n", " # Sidecar info\n", " meta = {\n", " 'source_file': csv_path.name,\n", " 'original_size_mb': round(raw_mb, 2),\n", " 'raw_samples': n_raw,\n", " 'raw_fs': cfg['original_fs'],\n", " 'target_fs': cfg['target_fs'],\n", " 'samples': int(len(u16)),\n", " 'duration_sec': round(len(u16) / cfg['target_fs'], 2),\n", " 'dtype': 'uint16',\n", " 'value_offset': cfg['uint16_offset'],\n", " 'baseline_window_sec': cfg['baseline_sec'],\n", " 'preprocess_time_sec': round(time.time() - t0, 1),\n", " }\n", " meta_path.write_text(json.dumps(meta, indent=2))" ] }, { "cell_type": "code", "execution_count": 6, "id": "e12c7263", "metadata": {}, "outputs": [ { "name": "stdout", "output_type": "stream", "text": [ "9 files, smallest → largest:\n", " 29.6 MB 8. suction_MIDDLE_CONC_1ml_(and_no_resuction).csv\n", " 30.2 MB 5. suction_HIGH_CONC_1ml_and_no_resuction.csv\n", " 30.9 MB 9. suction_MIDDLE_CONC_1ml_(and_no_resuction (2)).csv\n", " 55.2 MB 6. suction_MIDDLE_CONC_3ml_(and_no_resuction).csv\n", " 126.4 MB 7. suction_MIDDLE_CONC_2ml_(and_1_times_resuction).csv\n", " 182.7 MB 4. suction_HIGH_CONC_1ml_(and_2_times_resuction).csv\n", " 265.1 MB 3. suction_HIGH_CONC_2ml_(and_2_times_resuction.csv\n", " 343.7 MB 2. suction_HIGH_CONC_4ml_(and_2_times_resuction).csv\n", " 7242.4 MB 1. LONG_suction_HIGH_CONC_4ml_(and_3_times_resuction).csv\n", "\n", "8. suction_MIDDLE_CONC_1ml_(and_no_resuction).csv: .bin already exists (set overwrite=True to redo)\n", "5. suction_HIGH_CONC_1ml_and_no_resuction.csv: .bin already exists (set overwrite=True to redo)\n", "9. suction_MIDDLE_CONC_1ml_(and_no_resuction (2)).csv: .bin already exists (set overwrite=True to redo)\n", "6. suction_MIDDLE_CONC_3ml_(and_no_resuction).csv: .bin already exists (set overwrite=True to redo)\n", "7. suction_MIDDLE_CONC_2ml_(and_1_times_resuction).csv: .bin already exists (set overwrite=True to redo)\n", "4. suction_HIGH_CONC_1ml_(and_2_times_resuction).csv: .bin already exists (set overwrite=True to redo)\n", "3. suction_HIGH_CONC_2ml_(and_2_times_resuction.csv: .bin already exists (set overwrite=True to redo)\n", "2. suction_HIGH_CONC_4ml_(and_2_times_resuction).csv: .bin already exists (set overwrite=True to redo)\n", "1. LONG_suction_HIGH_CONC_4ml_(and_3_times_resuction).csv: .bin already exists (set overwrite=True to redo)\n" ] } ], "source": [ "# Cell 5: Batch run, smallest files first\n", "files = sorted(CFG['input_dir'].glob('*.csv'), key=lambda p: p.stat().st_size)\n", "print(f"{len(files)} files, smallest → largest:")\n", "for f in files:\n", " print(f" {f.stat().st_size/10242:8.1f} MB {f.name}")\n", "print()\n", "\n", "for csv_path in files:\n", " try:\n", " preprocess_file(csv_path, CFG)\n", " gc.collect()\n", " except Exception as e:\n", " print(f"{csv_path.name}: {e}")" ] }, { "cell_type": "code", "execution_count": 7, "id": "f1c28ce3", "metadata": {}, "outputs": [], "source": [ "# Cell 6: Region Detection Configuration\n", "REGION_CONFIG = {\n", " 'data_dir': Path('./Test signals from previous years/Suction data/Preprocessed'),\n", " 'output_dir': Path('./Test signals from previous years/Suction data/Region'),\n", "\n", " # Activity detection thresholds\n", " 'activity_window_samples': 50, # activity_window_samples1000/Hz = ms of sliding window, where Hz is the downsampled Hz\n", " 'activity_multiplier': 2.0, # >activity_multiplierbaseline = active \n", " 'min_region_duration_sec': 0.5, # Ignore regions shorter than this (noise)\n", " 'padding_sec': 0.2, # Add buffer before/after each region, in seconds\n", "}\n", "REGION_CONFIG['target_fs'] = CFG['target_fs']\n", "REGION_CONFIG['padding_samples'] = int(REGION_CONFIG['padding_sec'] * CFG['target_fs'])\n", "REGION_CONFIG['output_dir'].mkdir(parents=True, exist_ok=True)" ] }, { "cell_type": "code", "execution_count": 8, "id": "b5c5329d", "metadata": {}, "outputs": [], "source": [ "# Cell 7: Active Region Detection + Extraction\n", "def detect_regions_and_extract(bin_path, cfg):\n", " """\n", " Detect contiguous active regions → store as blocks → save\n", " Output: filename, time, file size, percent stored\n", " """\n", " meta_path = bin_path.with_suffix('.meta.json')\n", " if not meta_path.exists():\n", " raise FileNotFoundError(f"No metadata found for {bin_path}")\n", "\n", " meta = json.loads(meta_path.read_text())\n", "\n", " # Memory-map original data\n", " raw_data = np.memmap(str(bin_path), dtype='uint16', mode='r')\n", " centered = (raw_data.astype(np.int32) - meta['value_offset'])\n", "\n", " # Compute rolling std to detect activity\n", " activity_std = pd.Series(centered).rolling(cfg['activity_window_samples'], center=True, min_periods=1).std().to_numpy()\n", " \n", " # Baseline is overall std\n", " baseline_std = np.std(centered)\n", " activity_threshold = cfg['activity_multiplier'] * baseline_std\n", " \n", " # Mark active samples (where local std > threshold)\n", " active_mask = activity_std > activity_threshold\n", "\n", " # Find contiguous active regions\n", " regions = []\n", " in_region = False\n", " region_start = 0\n", " \n", " for i, is_active in enumerate(active_mask):\n", " if is_active and not in_region:\n", " region_start = i\n", " in_region = True\n", " elif not is_active and in_region:\n", " region_end = i\n", " \n", " # Apply padding\n", " padded_start = max(0, region_start - cfg['padding_samples'])\n", " padded_end = min(len(centered), region_end + cfg['padding_samples'])\n", " \n", " # Skip too-short regions\n", " duration_sec = (padded_end - padded_start) / cfg['target_fs']\n", " if duration_sec >= cfg['min_region_duration_sec']:\n", " regions.append({\n", " 'global_start': int(padded_start),\n", " 'global_end': int(padded_end),\n", " 'duration_sec': round(duration_sec, 4),\n", " })\n", " \n", " in_region = False\n", "\n", " if in_region:\n", " padded_start = max(0, region_start - cfg['padding_samples'])\n", " padded_end = len(centered)\n", " duration_sec = (padded_end - padded_start) / cfg['target_fs']\n", " \n", " if duration_sec >= cfg['min_region_duration_sec']:\n", " regions.append({\n", " 'global_start': int(padded_start),\n", " 'global_end': int(padded_end),\n", " 'duration_sec': round(duration_sec, 4),\n", " })\n", "\n", " # Concatenate all region data\n", " all_region_data = []\n", " for region in regions:\n", " segment = centered[region['global_start']:region['global_end']]\n", " all_region_data.append(segment)\n", "\n", " if len(all_region_data) > 0:\n", " compressed_regions = np.concatenate(all_region_data).astype(np.uint16) + meta['value_offset']\n", " else:\n", " compressed_regions = np.array([], dtype=np.uint16)\n", "\n", " # Calculate stats\n", " total_stored_samples = len(compressed_regions)\n", " total_original_samples = meta['samples']\n", " compression_ratio = total_original_samples / total_stored_samples if total_stored_samples > 0 else 1.0\n", " total_region_duration = sum(r['duration_sec'] for r in regions)\n", "\n", " # Build output metadata\n", " output_meta = {\n", " 'source_file': bin_path.name,\n", " 'original_duration_sec': meta['duration_sec'],\n", " 'original_samples': total_original_samples,\n", " 'num_regions': len(regions),\n", " 'stored_regions': regions,\n", " 'total_stored_samples': total_stored_samples,\n", " 'compression_ratio': round(compression_ratio, 2),\n", " 'original_size_mb': meta.get('original_size_mb', 0),\n", " 'stored_size_mb': round(total_stored_samples * 2 / 1024**2, 3),\n", " 'total_region_duration_sec': round(total_region_duration, 2),\n", " 'region_efficiency': round(total_region_duration / meta['duration_sec'], 4),\n", " 'baseline_std': round(baseline_std, 2),\n", " 'activity_threshold': round(activity_threshold, 2),\n", " 'value_offset': meta['value_offset'],\n", " 'target_fs': cfg['target_fs'],\n", " 'zstd_compressed': False,\n", " }\n", "\n", " # Determine output path\n", " output_path = cfg['output_dir'] / (bin_path.stem + 'regions.bin')\n", " meta_path_out = cfg['output_dir'] / (bin_path.stem + 'regions.meta.json')\n", "\n", " # Write data\n", " if len(compressed_regions) > 0:\n", " compressed_regions.tofile(output_path)\n", "\n", " # Write metadata\n", " meta_path_out.write_text(json.dumps(output_meta, indent=2))\n", "\n", " print(f"{output_meta['original_size_mb']:.2f}MB → {output_meta['stored_size_mb']:.2f}MB ({output_meta['region_efficiency']100:.1f}% stored) | {bin_path.name}")\n", "\n", " return output_meta" ] }, { "cell_type": "code", "execution_count": 9, "id": "98daad2f", "metadata": {}, "outputs": [], "source": [ "# Cell 8: Full Batch Region Extraction (minimal output)\n", "def run_batch_region_extraction():\n", " """Process all .bin files with region-based extraction (uncompressed)"""\n", " bin_files = sorted(REGION_CONFIG['data_dir'].glob('.bin'))\n", "\n", " results = []\n", " total_original_mb = 0\n", " total_stored_mb = 0\n", " total_time = 0\n", "\n", " for i, bin_path in enumerate(bin_files):\n", " start = time.time()\n", "\n", " try:\n", " result = detect_regions_and_extract(bin_path, REGION_CONFIG)\n", " elapsed = time.time() - start\n", " total_time += elapsed\n", "\n", " total_original_mb += result['original_size_mb']\n", " total_stored_mb += result['stored_size_mb']\n", "\n", " results.append({\n", " 'file': bin_path.name,\n", " **result,\n", " 'processing_ms': round(elapsed * 1000, 1),\n", " })\n", "\n", " except Exception as e:\n", " print(f"{bin_path.name} | ERROR: {e}")\n", " results.append({'file': bin_path.name, 'error': str(e)})\n", "\n", " # Summary\n", " total_ratio = total_original_mb / total_stored_mb if total_stored_mb > 0 else 1\n", " print(f"{total_original_mb:.2f}MB → {total_stored_mb:.2f}MB ({(total_stored_mb/total_original_mb*100):.1f}% stored) | All files processed in {total_time:.1f}s")\n", "\n", " # Save results\n", " df = pd.DataFrame(results)\n", " df.to_csv(REGION_CONFIG['output_dir'] / 'region_extraction_results.csv', index=False)\n", "\n", " return results" ] }, { "cell_type": "code", "execution_count": 10, "id": "d236f528", "metadata": {}, "outputs": [], "source": [ "# Cell 9: Load Region Data Utility\n", "def load_region_data(region_bin_path):\n", " """Load region-based data (plain .bin files only)"""\n", " meta_path = region_bin_path.with_suffix('.meta.json')\n", " meta = json.loads(meta_path.read_text())\n", "\n", " # Load region data (uncompressed .bin)\n", " regions_data = np.fromfile(region_bin_path, dtype=np.uint16)\n", "\n", " # Convert back to centered values\n", " centered = regions_data.astype(np.int32) - meta['value_offset']\n", "\n", " # Reconstruct individual regions\n", " regions = []\n", " idx = 0\n", " for region_info in meta['stored_regions']:\n", " region_size = region_info['global_end'] - region_info['global_start']\n", " region_data = centered[idx:idx + region_size]\n", " regions.append({\n", " 'timestamp_sec': region_info['global_start'] / meta['target_fs'],\n", " 'data': region_data,\n", " 'duration_sec': region_info['duration_sec'],\n", " })\n", " idx += region_size\n", "\n", " return {\n", " 'regions': regions,\n", " 'num_regions': len(regions),\n", " 'meta': meta,\n", " }" ] }, { "cell_type": "code", "execution_count": 11, "id": "58da8c23", "metadata": {}, "outputs": [ { "name": "stdout", "output_type": "stream", "text": [ "7242.40MB → 0.64MB (4.0% stored) | 1. LONG_suction_HIGH_CONC_4ml(and_3_times_resuction).bin\n", "343.74MB → 0.06MB (7.7% stored) | 2. suction_HIGH_CONC_4ml(and_2_times_resuction).bin\n", "265.06MB → 0.06MB (10.5% stored) | 3. suction_HIGH_CONC_2ml_(and_2_times_resuction.bin\n", "182.69MB → 0.04MB (10.5% stored) | 4. suction_HIGH_CONC_1ml_(and_2_times_resuction).bin\n", "30.22MB → 0.01MB (9.8% stored) | 5. suction_HIGH_CONC_1ml_and_no_resuction.bin\n", "55.20MB → 0.00MB (2.9% stored) | 6. suction_MIDDLE_CONC_3ml_(and_no_resuction).bin\n", "126.44MB → 0.01MB (4.9% stored) | 7. suction_MIDDLE_CONC_2ml_(and_1_times_resuction).bin\n", "29.59MB → 0.00MB (0.0% stored) | 8. suction_MIDDLE_CONC_1ml_(and_no_resuction).bin\n", "30.91MB → 0.01MB (6.6% stored) | 9. suction_MIDDLE_CONC_1ml_(and_no_resuction (2)).bin\n", "8306.25MB → 0.83MB (0.0% stored) | All files processed in 0.8s\n" ] } ], "source": [ "# Cell 10: Run region extraction\n", "results = run_batch_region_extraction()" ] }, { "cell_type": "code", "execution_count": 12, "id": "f2cbdc9b", "metadata": {}, "outputs": [], "source":
